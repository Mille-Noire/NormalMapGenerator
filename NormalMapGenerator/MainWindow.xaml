<Window x:Class="NormalMapGenerator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="NormalMapGenerator"
        Height="720"
        Width="1120"
        MinHeight="560"
        MinWidth="860">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="12"
                BorderBrush="#D0D5DD"
                BorderThickness="1"
                Background="#F8FAFC">
            <DockPanel LastChildFill="True">
                <Button x:Name="LoadHeightmapButton"
                        Content="Load Heightmap"
                        MinWidth="132"
                        Padding="12,6"
                        Margin="0,0,18,0"
                        Click="LoadHeightmapButton_Click" />

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="Strength"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0" />
                    <Button x:Name="DecreaseStrengthButton"
                            Content="-"
                            Width="18"
                            Height="18"
                            Padding="0"
                            Margin="0,0,6,0"
                            Click="DecreaseStrengthButton_Click"
                            ToolTip="Decrease strength by 0.01. Hold Shift for 0.1." />
                    <Slider x:Name="StrengthSlider"
                            Width="220"
                            Minimum="0"
                            Maximum="20"
                            Value="5"
                            TickFrequency="1"
                            IsSnapToTickEnabled="False"
                            VerticalAlignment="Center"
                            ValueChanged="SettingsChanged" />
                    <Button x:Name="IncreaseStrengthButton"
                            Content="+"
                            Width="18"
                            Height="18"
                            Padding="0"
                            Margin="6,0,0,0"
                            Click="IncreaseStrengthButton_Click"
                            ToolTip="Increase strength by 0.01. Hold Shift for 0.1." />
                    <TextBox x:Name="StrengthValueText"
                             Text="5.00"
                             Width="58"
                             Margin="8,0,18,0"
                             Padding="4,2"
                             VerticalContentAlignment="Center"
                             TextChanged="StrengthValueText_TextChanged"
                             LostFocus="StrengthValueText_LostFocus"
                             KeyDown="StrengthValueText_KeyDown"
                             ToolTip="Enter a strength value from 0 to 20." />

                    <CheckBox x:Name="InvertXCheckBox"
                              Content="Invert X"
                              Margin="0,0,16,0"
                              VerticalAlignment="Center"
                              Checked="SettingsChanged"
                              Unchecked="SettingsChanged" />
                    <CheckBox x:Name="InvertYCheckBox"
                              Content="Invert Y"
                              IsChecked="True"
                              VerticalAlignment="Center"
                              Checked="SettingsChanged"
                              Unchecked="SettingsChanged" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1"
              Margin="0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Grid.Column="0"
                       Text="Source Heightmap"
                       FontWeight="SemiBold"
                       Margin="0,0,0,8" />
            <TextBlock Grid.Row="0"
                       Grid.Column="2"
                       Text="Generated Normal Map"
                       FontWeight="SemiBold"
                       Margin="0,0,0,8" />

            <Border Grid.Row="1"
                    Grid.Column="0"
                    BorderBrush="#D0D5DD"
                    BorderThickness="1"
                    Background="#111827">
                <Image x:Name="SourcePreviewImage"
                       Stretch="Uniform"
                       SnapsToDevicePixels="True" />
            </Border>

            <Border Grid.Row="1"
                    Grid.Column="2"
                    BorderBrush="#D0D5DD"
                    BorderThickness="1"
                    Background="#111827">
                <Image x:Name="NormalPreviewImage"
                       Stretch="Uniform"
                       SnapsToDevicePixels="True" />
            </Border>
        </Grid>

        <DockPanel Grid.Row="2"
                   LastChildFill="False">
            <Button x:Name="ExportNormalMapButton"
                    Content="Export Normal Map"
                    MinWidth="156"
                    Padding="12,6"
                    IsEnabled="False"
                    DockPanel.Dock="Right"
                    Click="ExportNormalMapButton_Click" />
        </DockPanel>
    </Grid>
</Window>
