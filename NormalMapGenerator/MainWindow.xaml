<Window x:Class="NormalMapGenerator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="NormalMapGenerator"
        Height="720"
        Width="1440"
        MinHeight="560"
        MinWidth="1180">
    <Window.Resources>
        <Style x:Key="InfoBadgeStyle"
               TargetType="Border">
            <Setter Property="Width"
                    Value="16" />
            <Setter Property="Height"
                    Value="16" />
            <Setter Property="CornerRadius"
                    Value="8" />
            <Setter Property="BorderBrush"
                    Value="#98A2B3" />
            <Setter Property="BorderThickness"
                    Value="1" />
            <Setter Property="Background"
                    Value="#FFFFFF" />
            <Setter Property="Margin"
                    Value="6,0,0,0" />
            <Setter Property="VerticalAlignment"
                    Value="Center" />
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="12"
                BorderBrush="#D0D5DD"
                BorderThickness="1"
                Background="#F8FAFC">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="280" />
                </Grid.ColumnDefinitions>

                <Button x:Name="LoadHeightmapButton"
                        Grid.Column="0"
                        Content="Load Heightmap"
                        MinWidth="132"
                        Padding="12,6"
                        VerticalAlignment="Top"
                        Click="LoadHeightmapButton_Click" />

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Normal Map Settings"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8" />

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="112" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="0,0,8,0">
                            <TextBlock Text="Strength"
                                       VerticalAlignment="Center" />
                            <Border Style="{StaticResource InfoBadgeStyle}">
                                <Border.ToolTip>
                                    <TextBlock MaxWidth="280"
                                               TextWrapping="Wrap"
                                               Text="Controls how strongly height differences bend the generated normals. 0.00 is almost flat, 5.00 is the default, higher values create stronger normal detail." />
                                </Border.ToolTip>
                                <TextBlock Text="i"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="#475467"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                        </StackPanel>
                        <Button x:Name="DecreaseStrengthButton"
                                Grid.Column="1"
                                Content="-"
                                Width="18"
                                Height="18"
                                Padding="0"
                                Margin="0,0,6,0"
                                Click="DecreaseStrengthButton_Click"
                                ToolTip="Decrease strength by 0.01. Hold Shift for 0.1." />
                        <Slider x:Name="StrengthSlider"
                                Grid.Column="2"
                                Minimum="0"
                                Maximum="20"
                                Value="5"
                                TickFrequency="1"
                                IsSnapToTickEnabled="False"
                                VerticalAlignment="Center"
                                ValueChanged="SettingsChanged" />
                        <Button x:Name="IncreaseStrengthButton"
                                Grid.Column="3"
                                Content="+"
                                Width="18"
                                Height="18"
                                Padding="0"
                                Margin="6,0,0,0"
                                Click="IncreaseStrengthButton_Click"
                                ToolTip="Increase strength by 0.01. Hold Shift for 0.1." />
                        <TextBox x:Name="StrengthValueText"
                                 Grid.Column="4"
                                 Text="5.00"
                                 Width="58"
                                 Margin="8,0,0,0"
                                 Padding="4,2"
                                 VerticalContentAlignment="Center"
                                 LostFocus="StrengthValueText_LostFocus"
                                 KeyDown="StrengthValueText_KeyDown"
                                 ToolTip="Enter a strength value from 0 to 20." />
                        <Button x:Name="ResetStrengthButton"
                                Grid.Column="5"
                                Content="Reset"
                                MinWidth="46"
                                Padding="6,2"
                                Margin="8,0,0,0"
                                Click="ResetStrengthButton_Click"
                                ToolTip="Reset strength to 5.00." />
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="112" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="0,0,8,0">
                            <TextBlock Text="Level"
                                       VerticalAlignment="Center" />
                            <Border Style="{StaticResource InfoBadgeStyle}">
                                <Border.ToolTip>
                                    <TextBlock MaxWidth="280"
                                               TextWrapping="Wrap"
                                               Text="Scales height contrast before normals are calculated. 0.00 flattens the heightmap, 1.00 is unchanged, values above 1.00 increase height contrast." />
                                </Border.ToolTip>
                                <TextBlock Text="i"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="#475467"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                        </StackPanel>
                        <Button x:Name="DecreaseLevelButton"
                                Grid.Column="1"
                                Content="-"
                                Width="18"
                                Height="18"
                                Padding="0"
                                Margin="0,0,6,0"
                                Click="DecreaseLevelButton_Click"
                                ToolTip="Decrease level by 0.01. Hold Shift for 0.1." />
                        <Slider x:Name="LevelSlider"
                                Grid.Column="2"
                                Minimum="0"
                                Maximum="3"
                                Value="1"
                                TickFrequency="0.1"
                                IsSnapToTickEnabled="False"
                                VerticalAlignment="Center"
                                ValueChanged="SettingsChanged" />
                        <Button x:Name="IncreaseLevelButton"
                                Grid.Column="3"
                                Content="+"
                                Width="18"
                                Height="18"
                                Padding="0"
                                Margin="6,0,0,0"
                                Click="IncreaseLevelButton_Click"
                                ToolTip="Increase level by 0.01. Hold Shift for 0.1." />
                        <TextBox x:Name="LevelValueText"
                                 Grid.Column="4"
                                 Text="1.00"
                                 Width="58"
                                 Margin="8,0,0,0"
                                 Padding="4,2"
                                 VerticalContentAlignment="Center"
                                 LostFocus="LevelValueText_LostFocus"
                                 KeyDown="LevelValueText_KeyDown"
                                 ToolTip="Enter a level value from 0 to 3." />
                        <Button x:Name="ResetLevelButton"
                                Grid.Column="5"
                                Content="Reset"
                                MinWidth="46"
                                Padding="6,2"
                                Margin="8,0,0,0"
                                Click="ResetLevelButton_Click"
                                ToolTip="Reset level to 1.00." />
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="112" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="0,0,8,0">
                            <TextBlock Text="Blur / Sharp"
                                       VerticalAlignment="Center" />
                            <Border Style="{StaticResource InfoBadgeStyle}">
                                <Border.ToolTip>
                                    <TextBlock MaxWidth="280"
                                               TextWrapping="Wrap"
                                               Text="Adjusts heightmap detail before normals are calculated. Negative values sharpen detail, 0.00 is unchanged, positive values blur and smooth noisy detail." />
                                </Border.ToolTip>
                                <TextBlock Text="i"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="#475467"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                        </StackPanel>
                        <Button x:Name="DecreaseBlurSharpButton"
                                Grid.Column="1"
                                Content="-"
                                Width="18"
                                Height="18"
                                Padding="0"
                                Margin="0,0,6,0"
                                Click="DecreaseBlurSharpButton_Click"
                                ToolTip="Decrease blur/sharp by 0.01. Hold Shift for 0.1." />
                        <Slider x:Name="BlurSharpSlider"
                                Grid.Column="2"
                                Minimum="-10"
                                Maximum="10"
                                Value="0"
                                TickFrequency="1"
                                IsSnapToTickEnabled="False"
                                VerticalAlignment="Center"
                                ValueChanged="SettingsChanged" />
                        <Button x:Name="IncreaseBlurSharpButton"
                                Grid.Column="3"
                                Content="+"
                                Width="18"
                                Height="18"
                                Padding="0"
                                Margin="6,0,0,0"
                                Click="IncreaseBlurSharpButton_Click"
                                ToolTip="Increase blur/sharp by 0.01. Hold Shift for 0.1." />
                        <TextBox x:Name="BlurSharpValueText"
                                 Grid.Column="4"
                                 Text="0.00"
                                 Width="58"
                                 Margin="8,0,0,0"
                                 Padding="4,2"
                                 VerticalContentAlignment="Center"
                                 LostFocus="BlurSharpValueText_LostFocus"
                                 KeyDown="BlurSharpValueText_KeyDown"
                                 ToolTip="Enter -10 to sharpen, 0 for unchanged, or 10 to blur." />
                        <Button x:Name="ResetBlurSharpButton"
                                Grid.Column="5"
                                Content="Reset"
                                MinWidth="46"
                                Padding="6,2"
                                Margin="8,0,0,0"
                                Click="ResetBlurSharpButton_Click"
                                ToolTip="Reset blur/sharp to 0.00." />
                    </Grid>

                    <StackPanel Orientation="Horizontal">
                        <CheckBox x:Name="InvertXCheckBox"
                                  Content="Invert X"
                                  Margin="0,0,16,0"
                                  VerticalAlignment="Center"
                                  Checked="SettingsChanged"
                                  Unchecked="SettingsChanged" />
                        <CheckBox x:Name="InvertYCheckBox"
                                  Content="Invert Y"
                                  IsChecked="True"
                                  Margin="0,0,16,0"
                                  VerticalAlignment="Center"
                                  Checked="SettingsChanged"
                                  Unchecked="SettingsChanged" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="4">
                    <TextBlock Text="3D Preview Settings"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8" />
                    <CheckBox x:Name="UseHeightmapAlbedoCheckBox"
                              Content="Use Heightmap Albedo"
                              Margin="0,0,0,10"
                              VerticalAlignment="Center"
                              Checked="UseHeightmapAlbedoChanged"
                              Unchecked="UseHeightmapAlbedoChanged" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Shape"
                                   Margin="0,0,12,0"
                                   VerticalAlignment="Center" />
                        <ComboBox x:Name="PreviewShapeComboBox"
                                  Grid.Column="1"
                                  MinWidth="120"
                                  SelectionChanged="PreviewShapeChanged">
                            <ComboBoxItem Content="Cube"
                                          Tag="Cube"
                                          IsSelected="True" />
                            <ComboBoxItem Content="Plane"
                                          Tag="Plane" />
                            <ComboBoxItem Content="Sphere"
                                          Tag="Sphere" />
                            <ComboBoxItem Content="Cylinder"
                                          Tag="Cylinder" />
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1"
              Margin="0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Grid.Column="0"
                       Text="Source Heightmap"
                       FontWeight="SemiBold"
                       Margin="0,0,0,8" />
            <TextBlock Grid.Row="0"
                       Grid.Column="2"
                       Text="Generated Normal Map"
                       FontWeight="SemiBold"
                       Margin="0,0,0,8" />
            <TextBlock Grid.Row="0"
                       Grid.Column="4"
                       Text="3D Preview"
                       FontWeight="SemiBold"
                       Margin="0,0,0,8" />

            <Border Grid.Row="1"
                    Grid.Column="0"
                    BorderBrush="#D0D5DD"
                    BorderThickness="1"
                    Background="#111827">
                <Image x:Name="SourcePreviewImage"
                       Stretch="Uniform"
                       SnapsToDevicePixels="True" />
            </Border>

            <Border Grid.Row="1"
                    Grid.Column="2"
                    BorderBrush="#D0D5DD"
                    BorderThickness="1"
                    Background="#111827">
                <Image x:Name="NormalPreviewImage"
                       Stretch="Uniform"
                       SnapsToDevicePixels="True" />
            </Border>

            <Border Grid.Row="1"
                    Grid.Column="4"
                    BorderBrush="#D0D5DD"
                    BorderThickness="1"
                    Background="#111827">
                <Grid>
                    <ContentControl x:Name="Preview3DHost" />
                    <TextBlock x:Name="Preview3DStatusText"
                               Text="3D preview unavailable"
                               Foreground="#F8FAFC"
                               Background="#99111827"
                               Padding="8,4"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="Collapsed" />
                </Grid>
            </Border>
        </Grid>

        <DockPanel Grid.Row="2"
                   LastChildFill="False">
            <Button x:Name="ExportNormalMapButton"
                    Content="Export Normal Map"
                    MinWidth="156"
                    Padding="12,6"
                    IsEnabled="False"
                    DockPanel.Dock="Right"
                    Click="ExportNormalMapButton_Click" />
        </DockPanel>
    </Grid>
</Window>
